public class operator {
    public static void main(String[] args) {
        int a = 3;
        int b = 4;

        int total = a + b;
        System.out.println(total);
        total += 5;
        System.out.println(total);
        total = total * 2;
        System.out.println(total);
        total -= 4;
        System.out.println(total);
        total = total / 2;
        System.out.println(total);

    }

}
